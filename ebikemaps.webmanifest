{
  "name": "eBike Maps",
  "short_name": "eBike Maps",
  "description": "Apple Maps-style turn-by-turn navigation for ebikes.",
  "start_url": "./EbikeMaps.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f2f2f7",
  "theme_color": "#0a84ff",
  "icons": [
    { "src": "icons/ebikemaps-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/ebikemaps-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/ebikemaps-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/ebikemaps-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Navigate Home",
      "short_name": "Home",
      "description": "Start navigating to your saved Home address",
      "url": "./EbikeMaps.html?go=home",
      "icons": [{ "src": "icons/ebikemaps-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Navigate to Work",
      "short_name": "Work",
      "description": "Start navigating to your saved Work address",
      "url": "./EbikeMaps.html?go=work",
      "icons": [{ "src": "icons/ebikemaps-192.png", "sizes": "192x192" }]
    }
  ]
}
